{
  "name": "idriftcheckco",
  "version": "0.2.0",
  "description": "Regression tests for AI coding agents. Replays the sessions you already have under a new model, prompt or config, and diffs the behavior.",
  "keywords": [
    "ai",
    "agents",
    "regression-testing",
    "llm",
    "evals",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "idriftcheckco": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "prepare": "tsc -p tsconfig.build.json",
    "assets": "tsx scripts/render-demo-svg.ts && tsx src/cli/bin.ts demo --out docs/demo/index.html"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.10.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicoleKurt/idriftcheckco.git"
  },
  "homepage": "https://micolekurt.github.io/idriftcheckco/demo/",
  "bugs": {
    "url": "https://github.com/MicoleKurt/idriftcheckco/issues"
  }
}
